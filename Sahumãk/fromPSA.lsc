Feature type(*cons, vowel, semivowel)
Feature place(bilabial, alveolar, postalveolar, velar, glottal)
Feature manner(stop, tap, fricative, affricate, nasal, lateral)
Feature height(low, mid, high)
Feature frontness(front, central, back)
Feature +nasalized
Feature (syllable) stress(*unstressed, secondary, primary)
feature voicing(unvoiced, voiced)
feature syllabic(syllabic)
Diacritic ˈ (floating) (before) [primary]
Diacritic ˌ (floating) (before) [secondary]
Symbol a [low back vowel]
Symbol ã [low back +nasalized vowel]
Symbol e [mid front vowel]
Symbol i [high front vowel]
Symbol ĩ [high front +nasalized vowel]
Symbol o [mid back vowel]
Symbol u [high back vowel]
Symbol ũ [high back +nasalized vowel]
Symbol ə [mid central vowel]
Symbol ɪ [high central vowel]
Symbol ʌ [low central vowel]

# consonants /p t k ts s h m n l r j w ʔ/
Symbol p [bilabial stop cons]
Symbol t [alveolar stop cons]
Symbol k [velar stop cons]
Symbol x [velar fricative cons]
Symbol ts [alveolar affricate cons]
Symbol s [alveolar fricative cons]
Symbol m [bilabial nasal cons]
Symbol n [alveolar nasal cons]
Symbol l [alveolar lateral cons]
Symbol r [velar lateral cons]
Symbol ɾ [alveolar voiced tap cons]

Symbol h [glottal fricative cons]
Symbol ʔ [glottal stop cons]
symbol j [high semivowel]
symbol w [low semivowel]

# consonants in Classical Sahumãk not in PSA
# (technically a lot of these existed as allophones in PSA)
Symbol b [bilabial stop cons voiced]
Symbol d [alveolar stop cons voiced]
Symbol g [velar stop cons voiced]
Symbol v [bilabial fricative cons voiced]
Symbol z [alveolar fricative cons voiced]
Symbol r̩ [alveolar tap cons syllabic]
Symbol tʃ [postalveolar affricate cons]


Deromanizer:
  ' => ʔ
  \? => ʔ
  \- => *
  y => j
  {Q,W,E,R,T,Y,U,I,O,P,A,S,D,F,G,H,J,K,L,Z,X,C,V,B,N,M} => * # uppercase letters are used for glossing. They are removed by the deromanizer.
  []$1 \: => $1 $1

Syllables:
  explicit

Syllables:
  clear

# this is mostly for handling long vowels that the deromanizer will have turned into duplications.
long-vowel-to-glide:
  [front vowel] => j / _ [vowel]
  [vowel] => w / _ [vowel]

nasal-overlap:
  [nasal] [vowel]? => * / [+nasalized] _

degemmination cleanup:
  [cons]$1 $1 => $1

lenition:
  {t, k, r} => {ɾ, h, ɾ} / [!cons] _ [!cons]

lateral-collapse:
  [lateral] => l / $ _
  [lateral] => r̩ / _ $
  [lateral] => j / {[cons] _ [vowel], [vowel] _ [cons]}
  then:
    j => * / _ {j, w}

lenition2:
  ɾ [!cons] => ʔ / ɾ [!cons] _ [!cons]
  ɾ [!cons] => * / ɾ [!cons] _

nasalize:
  [mid back] [nasal] => [low back +nasalized] ʔ // _ [!vowel]* [high vowel]
  [mid back] [nasal] => [high back +nasalized] ʔ
  [back] [nasal] => [back +nasalized] ʔ
  [front] n => ĩ ʔ
  [front] m => i b
  [central] n => ã ʔ
  [central] m => [central] v

tap-nasal:
  ɾ [vowel] => r / _ $
  ɾ => n / [+nasalized] _ // _ $

remove-glot:
  ʔ => j / {[front], [mid]} _ [!cons]
  ʔ => w / [back] _ [!cons]
  ʔ => ɾ / _ [cons] // $ _
  ʔ => *

split-clusters:
  [cons] s => ts
  s t => ts
  ɾ => ɾɪ / _ [cons]
  [nasal] => * / _ [cons]
  [cons]$1 [cons]$2 => $1 ə $2

strengthen-u:
  {u, ũ} => v / [vowel] _ // _ [!vowel]
  {u, ũ} => vu / $ _
  ũ => uv // _ [!vowel]
  {u, ũ} => * / _ w

remove-centrals:
  [cons]$1 [central] => * / _ $1
  [central] => * / {_ [vowel], [vowel] _}
  [low central] => [mid front]
  [central] => [front]

tsi-lenition:
  tsi => tʃi
  tsu => su
  ts => t

glide-rhotacization:
  j => ɾ / [vowel] _ [front]
  w => ɾ / [vowel] _ [back]

stranded-glide-vocalization:
  {j j?, w w?} => {ji, wo} // {[!cons] _, _ [!cons]}

initial-voicing:
 {s, t, p, k} => {z, d, b, g} / $ _

final-lenition:
  k => x / _ $

minimal-word:
  [!vowel]$1 => $1 u $1 / $ _ $

romanizer:
  j => y
  r̩ => r # distinct from the tap so we don't need the diacritic.
  x => hh # just because I will mis read it otherwise.