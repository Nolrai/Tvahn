
Feature type(*cons, vowel, semivowel)
Feature place(bilabial, alveolar, velar, glottal)
Feature manner(stop, fricative, affricate, nasal, lateral)
Feature height(low, mid, high)
Feature frontness(front, central, back)
Feature nasalized(nasalized)
Feature (syllable) stress(*unstressed, secondary, primary)
Diacritic ˈ (floating) (before) [primary]
Diacritic ˌ (floating) (before) [secondary]
Symbol a [low back vowel]
Symbol ã [low back nasalized vowel]
Symbol e [mid front vowel]
Symbol i [high front vowel]
Symbol ĩ [high front nasalized vowel]
Symbol o [mid back vowel]
Symbol u [high back vowel]
Symbol ũ [high back nasalized vowel]
Symbol ə [mid central vowel]
Symbol ɪ [high central vowel]
Symbol ʌ [low central vowel]

# consonants /p t k ts s h m n l r j w ʔ/
Symbol p [bilabial stop cons]
Symbol t [alveolar stop cons]
Symbol k [velar stop cons]
Symbol ts [alveolar affricate cons]
Symbol s [alveolar fricative cons]
Symbol m [bilabial nasal cons]
Symbol n [alveolar nasal cons]
Symbol l [alveolar lateral cons]
Symbol r [velar lateral cons]

Symbol h [glottal fricative cons]
Symbol ʔ [glottal stop cons]
symbol j [high semivowel]
symbol w [low semivowel]

Deromanizer:
  ' => ʔ
  \? => ʔ
  \- => *
  y => j
  {Q,W,E,R,T,Y,U,I,O,P,A,S,D,F,G,H,J,K,L,Z,X,C,V,B,N,M} => * # uppercase letters are used for glossing. They are removed by the deromanizer.

glide-simplificattion propagate cleanup:
 {w, j} => {u, i}

glide-reintroduction propagate cleanup:
  u => w / [vowel] _ [vowel]
  else:
  i => j / [vowel] _ [vowel]
  else:
  i => j / _ [vowel] // {[semivowel] _, _ [semivowel]}
  else:
  u => w / _ [vowel] // {[semivowel] _, _ [semivowel]}

glide-degeminate propagate cleanup:
  ww => uw
  jj => ij
  wii => wiji

merge-ts cleanup:
  t s => ts

Syllables:
  [!vowel]+ [vowel]+
  [vowel]+ / $ _
  [!vowel]+ / _ $
  n // _ [vowel]

primary-stress-second-last-syllable:
  <syl> => [primary] / _ <syl> $
  Else: <syl> => [primary]

add-secondary-stress rtl:
  <syl>&[unstressed] => [secondary] / _ <syl>&[unstressed] <syl>&[!unstressed]

# uu and ii are turned into dipthongs by the clean up rules.
long-vowels-to-diphthongs:
    aa => au
    ee => ei
    oo => ou

styncopate:
  [unstressed vowel] => * // h [!cons]* _
  h&[unstressed] => * / [!cons] _ [!cons]

hw-epenthesis:
  hw => huw / $ _
  hw => w

diphthong-simplify-near-cluster:
  ai => a / _ [cons] [cons]
  au => a / _ [cons] [cons]
  oi => o / _ [cons] [cons]
  ui => u / _ [cons] [cons]

nasal-metathesis:
  [cons]$1 {n, m}$2 => $2 $1 / _ $
  then:
    {j,y,w} {n, m} => {jĩ, jĩ, wũ} *

epenthesis-ih ltr:
  n [cons] => n [cons] # don't seperate n and cons
  [cons] n => [cons] n # don't seperate n and cons
  [cons]$1 [cons]$2 => $1 ɪ $2 / _ {j, i, ɪ}

epenthesis-uh rtl:
  [cons]$1 [cons]$2 => $1 ʌ $2 / {w, u, ʌ} _

epenthesis-centered propagate:
  [cons]$1 [cons]$2 => $1 ə $2 / _

special-ts:
  t => ts / _ ([!cons])+ s ([!cons])

special-s:
  n => s / _ ([!cons])+ s ([!cons])

syncope-sufix:
  ([!cons])+ r => * / _ ([!cons])+ s
  ([!cons])+ r s => * / _ ([!cons])+ s ([!cons])+ r

unstress-2:
  <syl> => [unstressed]

primary-stress-second-syllable:
  <syl> => [primary] / $ <syl> _ // $ <syl> _ $

primary-only-syllable:
  <syl> => [primary] / $ _ $

primary-stress-first-syllable-in-two-syllable-word:
  <syl> => [primary] / $ _ <syl> $

add-secondary-stress2 ltr:
  <syl>&[unstressed] => [secondary] / <syl>&[!unstressed] <syl>&[unstressed] _

weaken-unstressed-vowels:
  (ai)&[unstressed] => i
  (au)&[unstressed] => u
  (oi)&[unstressed] => o
  (ui)&[unstressed] => i
  (i)&[unstressed] => ɪ
  ({u,a,o})&[unstressed] => ʌ
  (e)&[unstressed] => ə

vowel-harmony ltr:
  [vowel]$1 ({s,r}+)$2 u => $1 $2 $1

remove-weak:
  {ɪ, ʌ, ə}&{[!primary]} => * / _ {s, ts, t}

final-lention:
  {ɪ, ʌ, ə} => {i, u, o} / _ $

degemination propagate:
  # [primary] ss => sɪs
  # [secondary] ss => sɪs
  ss => s
  tt => ts
  sts => ts
  tss => ts
  tst => tsɪs
  tsts => tsɪt
  [cons] s => s
  h [cons]$1 => $1

rs-epentisis:
  r s [vowel]$1 => r $1 s / _ $
  r s [vowel]$1 => r $1 s $1 / _
  r st [vowel]$1 => r $1 st / _ $
  r st [vowel]$1 => r $1 st $1 / _

epentisis:
  st => st
  ts => ts
  [cons]$1 [cons]$2 [vowel]$3 => $1 $3 $2 $3
  {p,m,t,k,ts,s,h,n,l,r} => {pe,me,ti,ki,tsi,si,hi,ni,li,ri} / _ [cons]

vowel-simplify propagate:
  [central] u [vowel] r => ur
  ɪi => i
  {ʌ,ə} i => ai
  uu [vowel]$1 => w $1 w $1
  {ʌ,ə,ɪ} => * / [!cons] _ [!cons]

long-central-vowel-simplify:
  ʌ {ʌ,ə} => a
  {ʌ,ə} ʌ => a
  ɪ {ə,ɪ} => i
  {ə,ɪ} ɪ => i
  ə ə => ʌ

nasalization:
  [vowel front] => ĩ / _ n
  [vowel back high] => ũ / _ n
  [vowel] => ã / _ n

nasal-syncope:
  n [central] => * / [nasalized] _
  n => * / _ [cons]
  n => * / _ $

strengthen-before-r:
  {ɪ, ʌ, ə} => {i, a, e} / _ r

unstress-3:
  [] => [unstressed]

romanizer:
  ʔ => * / {[cons] _, _ [cons]}
  j => y
